# Copy to .env (git-ignored) and fill in what you use. Every setting is optional.
# Full list with defaults: src/docrag/shared/settings.py (env prefix DOCRAG_).

# --- LLM providers (only providers with a key are registered) ---------------
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Tracing (both off by default) ------------------------------------------
# Phoenix (docker compose up -d phoenix):
# DOCRAG_OTEL_ENDPOINT=http://127.0.0.1:6006/v1/traces
# Langfuse Cloud (project settings -> API keys). Spans contain questions,
# prompts and document text, which then leave your machine.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
# Kill switch for all exporters:
# OTEL_SDK_DISABLED=true
# Context on every span (Langfuse filters by it):
# DOCRAG_ENVIRONMENT=development  # development (default) / ci / production
# DOCRAG_RELEASE=                 # e.g. image tag or git sha
# DOCRAG_TRACE_CONTENT=false      # keep questions, prompts and document text out of traces

# --- Operations ---------------------------------------------------------------
# DOCRAG_LOG_FORMAT=json          # text (default) or json
# DOCRAG_LOG_LEVEL=INFO
# DOCRAG_LLM_TIMEOUT_S=120        # per LLM attempt
# DOCRAG_LLM_MAX_RETRIES=2
# DOCRAG_QDRANT_TIMEOUT_S=30
# DOCRAG_QDRANT_MAX_RETRIES=2
# DOCRAG_REQUEST_TIMEOUT_S=150    # whole /query, retries included -> 504
# DOCRAG_READINESS_TIMEOUT_S=2    # /readyz waits this long for Qdrant
# DOCRAG_BUDGET_EUR=5.0           # hard stop for paid LLM calls per process
